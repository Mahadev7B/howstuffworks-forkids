OPENROUTER_API=your_openrouter_api_key_here
# Optional alias:
# OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
EMBEDDING_MODEL=local-hash
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/howstuffworks
SIMILARITY_THRESHOLD=0.84
MEDIA_STORAGE_PATH=media_store
LESSON_TIMEOUT_SECONDS=180
IMAGE_PARALLELISM=3
MAX_GENERATED_IMAGES=5
IMAGE_SIZE=auto
AUDIO_ENABLED=true
LOCAL_MEDIA_ONLY=false
LOCAL_TTS_ENABLED=false
